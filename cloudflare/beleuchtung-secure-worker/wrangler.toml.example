[vars]
ALLOWED_ORIGIN = "https://nero2026.github.io"
ALLOWED_IPS = ""
SHELLY_HOST = "https://shelly-239-eu.shelly.cloud"

# JSON array of devices. For larger lists use the CSV helper in this folder.
DEVICES_JSON = '''
[
  { "key": "test-shelly", "id": "d0cf13cb8708", "channel": 0, "enabled": true }
]
'''

# Optional legacy fallback if DEVICES_JSON entries omit id/auth_ref.
SHELLY_DEVICE_ID = ""
